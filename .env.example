# SQLite 文件位置（相对仓库根目录）
CINDER_DB_FILE=./data/cinder.db
# 播放代理链接签名密钥，随便一串长字符串，换了会让已发出的分片链接立即失效
CINDER_PROXY_SECRET=change-me-to-a-long-random-string
# 抓取定时任务的 cron 表达式，留空则不自动跑
CINDER_INGEST_CRON=0 */6 * * *

# 规则推理用的本地模型。三条路按顺序试，都没有就退回内置的启发式解析。
#   1) 任意 CLI：prompt 从 stdin 进，JSON 从 stdout 出
# CINDER_AI_CMD=ollama run qwen2.5:7b
#   2) 本机 ollama 的 HTTP 接口（装了 ollama 就自动走这条，不用配）
# CINDER_OLLAMA_HOST=http://127.0.0.1:11434
# CINDER_OLLAMA_MODEL=qwen2.5:7b
